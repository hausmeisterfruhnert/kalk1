# E-Mail-Versand (Anfrage an Sie + Kopie an den Kunden) – Daten vom E-Mail-Anbieter
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Fruhnert Hausmeisterservice <info@hausmeister-fruhnert.de>
MAIL_EMPFAENGER=info@hausmeister-fruhnert.de

# Preise dauerhaft speichern (kostenlos bei upstash.com, Redis-Datenbank anlegen → REST-URL + Token)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
