# Diese Werte NICHT hier eintragen, sondern bei Render unter "Environment"!
LEXOFFICE_API_KEY=
ADMIN_EMAIL=info@hausmeister-fruhnert.de
ADMIN_PASSWORT=
ERLAUBTE_DOMAINS=https://kalkulator.hausmeister-fruhnert.de

# Optional: feste Lexoffice-Artikel-IDs statt automatisch angelegter Artikel (KALK-...)
# ARTIKEL_TREPPENHAUS=
# ARTIKEL_HAUSMEISTER=
# ARTIKEL_WINTER=
# ARTIKEL_GARTEN=
# ARTIKEL_DACHRINNE=
